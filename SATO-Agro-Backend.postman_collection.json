          "name": "LLM Context",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/llm/context?crop={{crop}}&sowing_date={{sowing_date}}&lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
