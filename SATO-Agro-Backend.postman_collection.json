            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Supabase access token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"como va mi maiz\",\n  \"model\": \"{{model}}\",\n  \"crop\": \"{{crop}}\",\n  \"sowing_date\": \"{{sowing_date}}\",\n  \"lat\": {{lat}},\n  \"lon\": {{lon}},\n  \"target_date\": \"{{target_date}}\",\n  \"conversation\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"sembré en mayo\"\n    }\n  ]\n}"
            },
            "description": "Preferred backend-managed chat contract. Frontend may send a model, the backend injects runtime_context, runs the semantic tool loop, and keeps fallback routing to mistralai/mistral-medium-3.1."
          }
        },
