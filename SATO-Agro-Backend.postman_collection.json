{
  "info": {
    "name": "SATO-Agro Backend",
    "description": "Trimmed API collection for the SATO-Agro backend.\n\nPrimary routes live under /api/weather, /api/geo, /api/risk, and /api/llm.\nCompatibility routes are kept only for /api/v1/documents/latest and /api/v1/ai/tools/*.\n\nBase URL: http://127.0.0.1:5000\n\nTest coordinates: San Salvador (lat=13.69, lon=-89.21)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "lat",
      "value": "13.69"
    },
    {
      "key": "lon",
      "value": "-89.21"
    },
    {
      "key": "crop",
      "value": "maiz"
    },
    {
      "key": "sowing_date",
      "value": "2026-05-20"
    },
    {
      "key": "target_date",
      "value": "2026-08-15"
    }
  ],
  "item": [
    {
      "name": "Health & Root",
      "item": [
        {
          "name": "Root — Service Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Returns service name, version, and full list of available endpoints."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns service status and database connectivity (Supabase PostgreSQL)."
          }
        }
      ]
    },
    {
      "name": "Manifest-Aligned (Primary)",
      "description": "Preferred routes for new frontend and AI development.",
      "item": [
        {
          "name": "Weather Observed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather/observed?lat={{lat}}&lon={{lon}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "weather",
                "observed"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}",
                  "description": "Latitude of the point"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}",
                  "description": "Longitude of the point"
                }
              ]
            },
            "description": "Current observed weather bundle: temperature (current/max/min), wind, rainfall, nearest stations with distance and confidence."
          }
        },
        {
          "name": "Weather Forecast",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather/forecast?lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "weather",
                "forecast"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "YYYY-MM-DD. If >16 days away, returns scenario instead of precise forecast."
                }
              ]
            },
            "description": "Short-range forecast from Open-Meteo: temperature, rain, soil moisture, horizon classification, and warnings."
          }
        },
        {
          "name": "Geo Context",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/geo/context?lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "geo",
                "context"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "Optional. Used to select the correct seasonal outlook month."
                }
              ]
            },
            "description": "Territorial context: municipality, municipality_code, soil (organic matter, water retention), seasonal climate outlook from SNET."
          }
        },
        {
          "name": "Risk Assessment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/risk/assessment?crop={{crop}}&sowing_date={{sowing_date}}&lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "risk",
                "assessment"
              ],
              "query": [
                {
                  "key": "crop",
                  "value": "{{crop}}",
                  "description": "maiz or frijol"
                },
                {
                  "key": "sowing_date",
                  "value": "{{sowing_date}}",
                  "description": "YYYY-MM-DD"
                },
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "YYYY-MM-DD"
                }
              ]
            },
            "description": "Explainable crop risk assessment: risk level, score, phenological phase, climate state, canicula watch, recommendations, confidence, and assumptions."
          }
        },
        {
          "name": "LLM Context",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/llm/context?crop={{crop}}&sowing_date={{sowing_date}}&lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "context"
              ],
              "query": [
                {
                  "key": "crop",
                  "value": "{{crop}}"
                },
                {
                  "key": "sowing_date",
                  "value": "{{sowing_date}}"
                },
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}"
                }
              ]
            },
            "description": "Runtime context bundle for LLM assistants: observed weather, forecast, geo, phenology, official context — all in one payload."
          }
        },
        {
          "name": "LLM Context (Official Only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/llm/context?target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "context"
              ],
              "query": [
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "Returns only official seasonal snippets when crop/location params are omitted."
                }
              ]
            },
            "description": "Minimal context with only official seasonal snippets (no crop/location required)."
          }
        },
        {
          "name": "LLM Explain",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/llm/explain",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "explain"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"risk_assessment\": {\n    \"crop\": \"maiz\",\n    \"risk_level\": \"alto\",\n    \"risk_score\": 0.82,\n    \"phenology\": {\n      \"phase\": \"Llenado de grano\",\n      \"susceptibility\": \"alta\",\n      \"days_after_sowing\": 87\n    },\n    \"climate_state\": {\n      \"canicula_watch\": true,\n      \"rain_sum_mm\": 0.0,\n      \"temp_max_c\": 32.0,\n      \"seasonal\": \"vigilancia_canicula\"\n    },\n    \"recommendations\": [\n      \"Aplicar mulch para conservar humedad\",\n      \"Monitorear signos de estres hidrico\"\n    ]\n  }\n}"
            },
            "description": "Backend-generated plain-language explanation from a structured risk assessment. Requires risk_assessment object in body."
          }
        }
      ]
    },
