{
  "info": {
    "name": "SATO-Agro Backend",
    "description": "Trimmed API collection for the SATO-Agro backend.\n\nPrimary routes live under /api/weather, /api/geo, /api/risk, and /api/llm.\nThe preferred chat contract is POST /api/llm/chat, where frontend may send a model and the backend keeps OpenRouter fallback routing to mistralai/mistral-medium-3.1.\nCompatibility routes are kept only for /api/v1/documents/latest and the 4 semantic AI tools announced by the backend manifest.\n\nBase URL: http://127.0.0.1:5000\n\nTest coordinates: San Salvador (lat=13.69, lon=-89.21)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "lat",
      "value": "13.69"
    },
    {
      "key": "lon",
      "value": "-89.21"
    },
    {
      "key": "crop",
      "value": "maiz"
    },
    {
      "key": "sowing_date",
      "value": "2026-05-20"
    },
    {
      "key": "target_date",
      "value": "2026-08-15"
    },
    {
      "key": "model",
      "value": "mistralai/mistral-medium-3.1"
    }
  ],
  "item": [
    {
      "name": "Health & Root",
      "item": [
        {
          "name": "Root — Service Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Returns service name, version, and full list of available endpoints."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns service status and database connectivity (Supabase PostgreSQL)."
          }
        }
      ]
    },
    {
      "name": "Manifest-Aligned (Primary)",
      "description": "Preferred routes for new frontend and AI development.",
      "item": [
        {
          "name": "Weather Observed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather/observed?lat={{lat}}&lon={{lon}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "weather",
                "observed"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}",
                  "description": "Latitude of the point"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}",
                  "description": "Longitude of the point"
                }
              ]
            },
            "description": "Current observed weather bundle: temperature (current/max/min), wind, rainfall, nearest stations with distance and confidence."
          }
        },
        {
          "name": "Weather Forecast",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather/forecast?lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "weather",
                "forecast"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "YYYY-MM-DD. If >16 days away, returns scenario instead of precise forecast."
                }
              ]
            },
            "description": "Short-range forecast from Open-Meteo: temperature, rain, soil moisture, horizon classification, and warnings."
          }
        },
        {
          "name": "Geo Context",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/geo/context?lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "geo",
                "context"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "Optional. Used to select the correct seasonal outlook month."
                }
              ]
            },
            "description": "Territorial context: municipality, municipality_code, soil (organic matter, water retention), seasonal climate outlook from SNET."
          }
        },
        {
          "name": "Risk Assessment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/risk/assessment?crop={{crop}}&sowing_date={{sowing_date}}&lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "risk",
                "assessment"
              ],
              "query": [
                {
                  "key": "crop",
                  "value": "{{crop}}",
                  "description": "maiz or frijol"
                },
                {
                  "key": "sowing_date",
                  "value": "{{sowing_date}}",
                  "description": "YYYY-MM-DD"
                },
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "YYYY-MM-DD"
                }
              ]
            },
            "description": "Explainable crop risk assessment: risk level, score, phenological phase, climate state, canicula watch, recommendations, confidence, and assumptions."
          }
        },
        {
          "name": "LLM Context",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/llm/context?crop={{crop}}&sowing_date={{sowing_date}}&lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "context"
              ],
              "query": [
                {
                  "key": "crop",
                  "value": "{{crop}}"
                },
                {
                  "key": "sowing_date",
                  "value": "{{sowing_date}}"
                },
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}"
                }
              ]
            },
            "description": "Runtime context bundle for LLM assistants: observed weather, forecast, plant state, official context, risk assessment, and source policy."
          }
        },
        {
          "name": "LLM Context (Official Only)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/llm/context?target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "context"
              ],
              "query": [
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "Returns only official seasonal snippets when crop/location params are omitted."
                }
              ]
            },
            "description": "Minimal context with only official seasonal snippets (no crop/location required)."
          }
        },
        {
          "name": "LLM Chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/llm/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "chat"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"como va mi maiz\",\n  \"model\": \"{{model}}\",\n  \"crop\": \"{{crop}}\",\n  \"sowing_date\": \"{{sowing_date}}\",\n  \"lat\": {{lat}},\n  \"lon\": {{lon}},\n  \"target_date\": \"{{target_date}}\",\n  \"conversation\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"sembré en mayo\"\n    }\n  ]\n}"
            },
            "description": "Preferred backend-managed chat contract. Frontend may send a model, the backend injects runtime_context, runs the semantic tool loop, and keeps fallback routing to mistralai/mistral-medium-3.1."
          }
        },
        {
          "name": "LLM Explain",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/llm/explain",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "explain"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"risk_assessment\": {\n    \"risk_level\": \"alto\",\n    \"risk_score\": 0.82,\n    \"confidence\": \"media_alta\",\n    \"risk_factors\": [\n      {\n        \"label\": \"Deficit hidrico\",\n        \"state\": \"severo\"\n      }\n    ]\n  },\n  \"plant_state\": {\n    \"phase\": \"Llenado de grano\"\n  },\n  \"official_context\": {\n    \"canicula_2026_watch\": true\n  },\n  \"recommendations\": [\n    \"Aplicar mulch para conservar humedad\",\n    \"Monitorear signos de estres hidrico\"\n  ],\n  \"audience\": \"productor\"\n}"
            },
            "description": "Backend-generated plain-language explanation from a structured risk assessment. Requires risk_assessment object in body."
          }
        }
      ]
    },
    {
      "name": "Compatibility",
      "description": "Kept only for document discovery and the 4 semantic AI tool integrations announced by the backend manifest. Use this folder for MCP or external tool-calling agents, not for the main product chat.",
      "item": [
        {
          "name": "V1 Latest Documents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/documents/latest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "documents",
                "latest"
              ]
            },
            "description": "Returns all 3 latest documents (48h forecast, weekly PDF, agro bulletin) with IDs, types, URLs, and issue dates."
          }
        },
        {
          "name": "AI Tools Manifest",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/tools/manifest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "tools",
                "manifest"
              ]
            },
            "description": "Returns the function-calling manifest with the 4 semantic tools currently announced by the backend."
          }
        },
        {
          "name": "Tool: getRiskAssessment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/tools/call",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "tools",
                "call"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"getRiskAssessment\",\n  \"arguments\": {\n    \"crop\": \"maiz\",\n    \"sowing_date\": \"2026-05-20\",\n    \"lat\": 13.69,\n    \"lon\": -89.21,\n    \"target_date\": \"2026-08-15\"\n  }\n}"
            },
            "description": "Manifest-aligned risk assessment using observed, forecast, geo, and official context. Required: crop, sowing_date, lat, lon."
          }
        },
        {
          "name": "Tool: getOfficialContext",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/tools/call",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "tools",
                "call"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"getOfficialContext\",\n  \"arguments\": {\n    \"target_date\": \"2026-08-15\"\n  }\n}"
            },
            "description": "Official 2026 canicula context and seasonal explanation snippets. Required: target_date."
          }
        },
        {
          "name": "Tool: getPhenologyContext",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/tools/call",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "tools",
                "call"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"getPhenologyContext\",\n  \"arguments\": {\n    \"crop\": \"maiz\",\n    \"sowing_date\": \"2026-05-20\",\n    \"target_date\": \"2026-08-15\"\n  }\n}"
            },
            "description": "Estimated phenological phase and susceptibility from crop + sowing date. Required: crop, sowing_date. Optional: target_date."
          }
        },
        {
          "name": "Tool: getPhenologyContext (Frijol)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/tools/call",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "tools",
                "call"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"getPhenologyContext\",\n  \"arguments\": {\n    \"crop\": \"frijol\",\n    \"sowing_date\": \"2026-06-01\",\n    \"target_date\": \"2026-09-01\"\n  }\n}"
            },
            "description": "Phenology example for frijol (bean) crop."
          }
        },
        {
          "name": "Tool: explainRecommendation",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/tools/call",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "ai",
                "tools",
                "call"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"explainRecommendation\",\n  \"arguments\": {\n    \"risk_assessment\": {\n      \"risk_level\": \"alto\",\n      \"risk_score\": 0.82\n    },\n    \"official_context\": {\n      \"canicula_2026_watch\": true\n    },\n    \"audience\": \"productor\"\n  }\n}"
            },
            "description": "Turn a risk assessment into a simple explanation for the producer or extension team. Required: risk_assessment. Optional: official_context, plant_state, recommendations, audience."
          }
        }
      ]
    }
  ]
}
