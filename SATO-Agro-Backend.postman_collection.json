{
  "info": {
    "name": "SATO-Agro Backend",
    "description": "Trimmed API collection for the SATO-Agro backend.\n\nPrimary routes live under /api/weather, /api/geo, /api/risk, /api/llm, and /api/auth.\nAll /api/* routes require Authorization: Bearer <supabase_access_token>, except / and /health.\nThe preferred chat contract is POST /api/llm/chat, where frontend may send a model and the backend keeps OpenRouter fallback routing to mistralai/mistral-medium-3.1.\nCompatibility routes are kept for /api/v1/documents/latest and the semantic AI tools announced by the backend manifest.\n\nBase URL: http://127.0.0.1:5000\nTest coordinates: San Salvador (lat=13.69, lon=-89.21)\nTest user: <test-email> / <test-password>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "lat",
      "value": "13.69"
    },
    {
      "key": "lon",
      "value": "-89.21"
    },
    {
      "key": "crop",
      "value": "maiz"
    },
    {
      "key": "sowing_date",
      "value": "2026-05-20"
    },
    {
      "key": "target_date",
      "value": "2026-08-15"
    },
    {
      "key": "model",
      "value": "mistralai/mistral-medium-3.1"
    },
    {
      "key": "supabaseUrl",
      "value": "https://<project-ref>.supabase.co"
    },
    {
      "key": "supabasePublishableKey",
      "value": "<your-anon-key>"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "testUserEmail",
      "value": "<test-email>"
    },
    {
      "key": "testUserPassword",
      "value": "<test-password>"
    }
  ],
  "item": [
    {
      "name": "Health & Root",
      "item": [
        {
          "name": "Root — Service Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Returns service name, version, and full list of available endpoints."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns service status and database connectivity (Supabase PostgreSQL)."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Supabase login plus backend session bootstrap. Run password login first, copy access_token into {{accessToken}}, then call Backend Me.",
      "item": [
        {
          "name": "Supabase Password Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}",
                "description": "Supabase publishable key"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "token"
              ],
              "query": [
                {
                  "key": "grant_type",
                  "value": "password"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testUserEmail}}\",\n  \"password\": \"{{testUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Login directo contra Supabase Auth. Copia data.access_token de la respuesta en la variable {{accessToken}}."
          }
        },
        {
          "name": "Backend Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Supabase access token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Valida el JWT contra el backend y devuelve claims + profile."
          }
        }
      ]
    },
    {
      "name": "Manifest-Aligned (Primary)",
      "description": "Preferred routes for new frontend and AI development.",
      "item": [
        {
          "name": "Auth Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Supabase access token"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Current authenticated user plus linked producer profile."
          }
        },
        {
          "name": "Weather Observed",
          "request": {
            "method": "GET",
            "url": {
