          "name": "LLM Chat",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/llm/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "llm",
                "chat"
              ]
