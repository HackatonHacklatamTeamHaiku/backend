              "path": [
                "api",
                "llm",
                "context"
              ],
              "query": [
                {
                  "key": "crop",
                  "value": "{{crop}}"
                },
                {
                  "key": "sowing_date",
                  "value": "{{sowing_date}}"
                },
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}"
                }
