              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "YYYY-MM-DD. If >16 days away, returns scenario instead of precise forecast."
                }
              ]
            },
            "description": "Short-range forecast from Open-Meteo: temperature, rain, soil moisture, horizon classification, and warnings.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Supabase access token"
              }
            ]
          }
        },
        {
          "name": "Geo Context",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/geo/context?lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "geo",
                "context"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "Optional. Used to select the correct seasonal outlook month."
                }
              ]
            },
            "description": "Territorial context: municipality, municipality_code, soil (organic matter, water retention), seasonal climate outlook from SNET.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Supabase access token"
              }
            ]
          }
        },
        {
          "name": "Risk Assessment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/risk/assessment?crop={{crop}}&sowing_date={{sowing_date}}&lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "risk",
                "assessment"
              ],
              "query": [
                {
                  "key": "crop",
                  "value": "{{crop}}",
                  "description": "maiz or frijol"
                },
                {
                  "key": "sowing_date",
                  "value": "{{sowing_date}}",
                  "description": "YYYY-MM-DD"
                },
                {
                  "key": "lat",
                  "value": "{{lat}}"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}"
                },
                {
                  "key": "target_date",
                  "value": "{{target_date}}",
                  "description": "YYYY-MM-DD"
                }
