                "weather",
                "observed"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}",
                  "description": "Latitude of the point"
                },
                {
                  "key": "lon",
                  "value": "{{lon}}",
                  "description": "Longitude of the point"
                }
              ]
            },
            "description": "Current observed weather bundle: temperature (current/max/min), wind, rainfall, nearest stations with distance and confidence.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "description": "Supabase access token"
              }
            ]
          }
        },
        {
          "name": "Weather Forecast",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/weather/forecast?lat={{lat}}&lon={{lon}}&target_date={{target_date}}",
