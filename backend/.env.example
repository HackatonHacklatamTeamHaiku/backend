# Flask
FLASK_DEBUG=true
SECRET_KEY=change-me-in-production

# Supabase REST
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# APP_LOCAL_TIMEZONE (optional): IANA zone for local calendars in the API.
# If omitted or left blank, defaults to America/El_Salvador (El Salvador).
APP_LOCAL_TIMEZONE=America/El_Salvador

# Auth / JWT
AUTH_ENABLED=true
AUTH_BYPASS_FOR_TESTING=false
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_TTL=3600
# Seconds of issuer/server clock drift tolerated for JWT iat/exp (default 60).
JWT_VALIDATE_LEEWAY_SECONDS=60

# OpenRouter / LLM
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=openai/gpt-5.4-nano
OPENROUTER_HTTP_REFERER=http://127.0.0.1:5000
OPENROUTER_TITLE=SATO-Agro Backend
OPENROUTER_CATEGORIES=backend,agriculture
OPENROUTER_MAX_TOOL_ROUNDS=4
LLM_SYSTEM_PROMPT_PATH=

# HTTP
HTTP_TIMEOUT=10
HTTP_RETRIES=2

# Cache TTLs (seconds)
CACHE_TTL_OBSERVATIONS=600
CACHE_TTL_RAINFALL=7200
CACHE_TTL_SOIL=86400
CACHE_TTL_BASINS=86400
CACHE_TTL_CLIMATE_OUTLOOK=21600
CACHE_TTL_FORECAST_DAILY=3600
CACHE_TTL_MUNICIPALITY_LOOKUP=86400
CACHE_TTL_STATION_METADATA=86400
CACHE_TTL_FORECAST_48H=1800
CACHE_TTL_WEEKLY_PDF=21600
CACHE_TTL_AGRO_PDF=21600

# Dev seed user
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!
TEST_USER_FULL_NAME=Productor de Prueba
TEST_USER_DISPLAY_NAME=Productor Prueba
